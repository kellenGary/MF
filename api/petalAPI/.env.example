# API .env.example — copy to api/petalAPI/.env and update for local development

# Database (Supabase PostgreSQL connection string)
ConnectionStrings__DefaultConnection=Host=...pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.xxxx;Password=your_password;SSL Mode=Require;Trust Server Certificate=true

# JWT Auth
Jwt__SecretKey=your-secret-key-at-least-32-chars-long

# Spotify Developer Credentials
Spotify__ClientId=your_spotify_client_id_here
Spotify__ClientSecret=your_spotify_client_secret_here
Spotify__RedirectUri=petal://callback